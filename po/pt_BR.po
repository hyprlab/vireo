msgstr "Média"

msgid "Large"
msgstr "Grande"

msgid "Original Size"
msgstr "Tamanho original"

msgid "Will be recompressed to the size shown when this is sent"
msgstr "Será recomprimida para o tamanho indicado quando for enviada"

msgid "Recompress to This Size on Send"
msgstr "Recomprimir para este tamanho ao enviar"

msgid "Paste with Formatting"
msgstr "Colar com formatação"

msgid "Paste as Plain Text"
msgstr "Colar como texto sem formatação"

msgid "Bold"
msgstr "Negrito"

msgid "Italic"
msgstr "Itálico"

