msgstr "Esquerda"

msgid "Right"
msgstr "Direita"

msgid "1 line"
msgstr "1 linha"

msgid "2 lines"
msgstr "2 linhas"

msgid "3 lines"
msgstr "3 linhas"

msgid "Shown in the dock, app grid and switcher, and by the tray icon."
msgstr "Exibido no dock, na grade e no alternador de aplicativos, além do ícone da área de notificação."

msgid "When displayed"
msgstr "Quando apresentado"

msgid "After two seconds"
msgstr "Após dois segundos"

msgid "Hidden behind a toggle"
msgstr "Oculto atrás de um botão de alternância"

msgid "Shown while hovering"
msgstr "Apresentado ao passar o ponteiro"

msgid "Always visible"
msgstr "Sempre visível"

msgid "Account of the current folder"
msgstr "Conta da pasta atual"

