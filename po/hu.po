msgstr "A(z) {id} aláírókulcs csak csekély mértékben megbízható a kulcstartóján."

msgid "Signing key {id} is marked as not trusted in your keyring."
msgstr "A(z) {id} aláírókulcs nem megbízhatóként van megjelölve a kulcstartóján."

msgid ""
"Signing key {id} is in your keyring but not marked as trusted; check its "
"fingerprint with the sender."
msgstr ""
"A(z) {id} aláírókulcs a kulcstartóján van, de nincs megbízhatóként "
"megjelölve; ellenőrizze az ujjlenyomatát a feladóval."

msgid "Signed with key {id}."
msgstr "A(z) {id} kulccsal aláírva."

msgid "Import the sender's public key to verify it."
msgstr "Az ellenőrzéshez importálja a feladó nyilvános kulcsát."

msgid "No key was found in that file."
msgstr "A fájlban nem található kulcs."

msgid "Nothing to export."
msgstr "Nincs exportálható adat."

msgid "gpg did not create the key."
msgstr "A gpg nem hozta létre a kulcsot."

msgid "No key was found for that address."
msgstr "Ehhez a címhez nem található kulcs."

msgid "gpg could not sign the key."
msgstr "A gpg nem tudta aláírni a kulcsot."

msgid "gpg could not delete the key."
msgstr "A gpg nem tudta törölni a kulcsot."

msgid "gpg did not sign the message."
msgstr "A gpg nem írta alá az üzenetet."

msgid "gpg did not encrypt the message."
msgstr "A gpg nem titkosította az üzenetet."

msgid "Open Vireo"
msgstr "Vireo megnyitása"

msgid "No unread mail"
msgstr "Nincs olvasatlan levél"

msgid "View all {n} unread…"
msgstr "Mind a(z) {n} olvasatlan megtekintése…"

msgid "Accounts"
msgstr "Fiókok"

msgid "Requires an app-specific password (not your normal login password)."
msgstr "Alkalmazásjelszó szükséges (nem a szokásos bejelentkezési jelszava)."

msgid "Sign in with your browser — no password needed."
msgstr "Jelentkezzen be a böngészőben — nincs szükség jelszóra."

msgid "Sign in through GNOME Online Accounts."
msgstr "Bejelentkezés a GNOME Online-fiókokon keresztül."

msgid "Requires Proton Mail Bridge running locally."
msgstr "A Proton Mail Bridge helyi futtatása szükséges."

msgid "Enable POP/IMAP access in GMX settings first."
msgstr "Először engedélyezze a POP/IMAP-hozzáférést a GMX beállításaiban."

msgid "Enter your provider's OAuth endpoints, then sign in."
msgstr "Adja meg a szolgáltató OAuth-végpontjait, majd jelentkezzen be."

msgid "Enter your server details manually."
msgstr "Adja meg kézzel a kiszolgáló adatait."

msgid "Mail Accounts"
msgstr "Levelezési fiókok"

msgid "Drag to set the order they appear in the sidebar."
msgstr "Húzással állítsa be az oldalsávban való megjelenési sorrendet."

msgid "GNOME Online Accounts"
msgstr "GNOME Online-fiókok"

msgid "Mail accounts from GNOME Settings. Toggle one on to use it in Vireo."
msgstr "A GNOME beállításaiból származó levelezési fiókok. Kapcsoljon be egyet a Vireóban való használatához."

msgid "Add Account"
msgstr "Fiók hozzáadása"

msgid ""
"Label messages with one or more coloured tags. Tags are stored on the mail "
"server as IMAP keywords, so Thunderbird and other clients show the same tags."
msgstr ""
"Üzenetek címkézése egy vagy több színes címkével. A címkék "
"IMAP-kulcsszóként tárolódnak a levelezőkiszolgálón, így a Thunderbird "
"és más kliensek ugyanazokat a címkéket jelenítik meg."

msgid "Add Tag…"
msgstr "Címke hozzáadása…"

msgid "Search filters"
msgstr "Keresési szűrők"

msgid "Filters"
msgstr "Szűrők"

msgid ""
"File incoming mail into folders or tag it automatically, by sender, subject "
"or recipients. Applied to each account's Inbox as Vireo syncs it."
msgstr ""
"Beérkező levelek automatikus mappázása vagy címkézése feladó, tárgy "
"vagy címzettek alapján. A szabályok az egyes fiókok Beérkezett üzenetek "
"mappájára érvényesülnek szinkronizáláskor."

msgid "Add Filter…"
msgstr "Szűrő hozzáadása…"

msgid "Search senders"
msgstr "Feladók keresése"

msgid "Allowed Senders"
msgstr "Engedélyezett feladók"

msgid "Messages from these senders load remote content automatically."
msgstr "Az ezektől a feladóktól érkező üzenetek automatikusan betöltik a távoli tartalmakat."

msgid "Email address"
msgstr "E-mail-cím"

msgid "Allow this sender"
msgstr "Feladó engedélyezése"

msgid "Blacklist"
msgstr "Tiltólista"

msgid ""
"Incoming mail from these senders is deleted automatically (moved to Trash). "
"Enter an email address, or a whole domain like \"example.com\" to block "
"every sender there."
msgstr ""
"Az ezektől a feladóktól érkező levelek automatikusan törlődnek (a "
"Kukába kerülnek). Adjon meg egy e-mail-címet vagy egy teljes tartományt, "
"például az „example.com” címet, hogy letiltsa az összes ottani feladót."

msgid "Address or domain"
msgstr "Cím vagy tartomány"

