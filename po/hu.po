msgstr "Új üzenet"

msgid "GnuPG (gpg) is not installed, so this message cannot be read."
msgstr "A GnuPG (gpg) nincs telepítve, ezért ez az üzenet nem olvasható."

msgid "Decrypted with your key."
msgstr "A saját kulcsával visszafejtve."

msgid "Encrypted to key {id}, which is not in your keyring."
msgstr "A(z) {id} kulccsal titkosítva, amely nincs a kulcstartóján."

msgid "The encrypted block is damaged or not OpenPGP data."
msgstr "A titkosított blokk sérült, vagy nem OpenPGP-adat."

msgid "Signing key {id} is trusted in your keyring."
msgstr "A(z) {id} aláírókulcs megbízható a kulcstartóján."

