msgstr "Impossible d'enregistrer le PDF : {error}"

msgid "Print…"
msgstr "Imprimer…"

msgid "Save as PDF…"
msgstr "Enregistrer au format PDF…"

msgid "Send as Attachment Instead"
msgstr "Envoyer plutôt en pièce jointe"

msgid "Small"
msgstr "Petit"

msgid "Medium"
msgstr "Moyen"

msgid "Large"
msgstr "Grand"

msgid "Original Size"
msgstr "Taille originale"

msgid "Will be recompressed to the size shown when this is sent"
msgstr "Sera recompressé à la taille indiquée lors de l'envoi"

msgid "Recompress to This Size on Send"
msgstr "Recompresser à cette taille lors de l'envoi"

msgid "Paste with Formatting"
msgstr "Coller avec la mise en forme"

msgid "Paste as Plain Text"
msgstr "Coller comme texte brut"

msgid "Bold"
msgstr "Gras"

msgid "Italic"
msgstr "Italique"

msgid "Underline"
msgstr "Souligné"

msgid "Strikethrough"
msgstr "Barré"

msgid "Bulleted list"
msgstr "Liste à puces"

msgid "Numbered list"
msgstr "Liste numérotée"

#. Adwaita has no blockquote glyph; the indent icon reads as "quote".
msgid "Quote"
msgstr "Citation"

#. `LINK` is a sentinel command (handled specially); the icon is real.
